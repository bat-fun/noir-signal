@import "~/.cache/noir-signal/rofi-colors.rasi"

configuration {
    modi: "drun";
    show-icons: true;

    drun-display-format: "{name}";
    drun-match-fields: "name,generic,exec,categories,keywords";

    display-drun: "APPS";

    kb-cancel: "Escape";
    kb-accept-entry: "Return";
    kb-remove-to-eol: "Control+E";
    kb-remove-to-sol: "Control+A";
}

* {
    bg:         #090A0C;
    surface:    #111318;
    surface-alt: #181B21;

    text:       #E7E4DC;
    muted:      @noir-muted;
    accent:     @noir-accent;
    danger:     #C46D6D;

    background-color: transparent;
    text-color: @text;

    font: "JetBrainsMono Nerd Font 11";
}

window {
    width: 500px;
    border: 1px;
    border-color: #2A2D32;
    border-radius: 12px;

    background-color: @bg;

    padding: 18px;
}

mainbox {
    spacing: 14px;
    children: [
        inputbar,
        listview
    ];
}

inputbar {
    padding: 10px 12px;

    background-color: @surface;
    border: 1px;
    border-color: #252930;
    border-radius: 8px;

    children: [
        prompt,
        entry
    ];
}

prompt {
    enabled: true;
    padding: 0 8px 0 0;
    text-color: @accent;
}

entry {
    placeholder: "Search applications...";
    placeholder-color: @muted;

    text-color: @text;
    cursor: text;
}

listview {
    columns: 1;
    lines: 5;

    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 10px 12px;
    border-radius: 7px;

    background-color: transparent;
}

element-icon {
    size: 22px;
    margin: 0 12px 0 0;
}

element-text {
    vertical-align: 0.5;
    text-color: @muted;
}

element selected {
    background-color: @surface-alt;
}

element selected element-text {
    text-color: @accent;
}

element selected element-icon {
    opacity: 1;
}