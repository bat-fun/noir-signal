configuration {
    show-icons: true;
    kb-cancel: "Escape";
    kb-accept-entry: "Return";
}

* {
    bg: #090A0C;
    surface: #111318;
    surface-alt: #181B21;
    text: #E7E4DC;
    muted: #777B82;
    accent: #D6A85F;

    font: "JetBrainsMono Nerd Font 10";
    text-color: @text;
    background-color: transparent;
}

window {
    width: 720px;
    border: 1px;
    border-color: #2A2D32;
    border-radius: 12px;
    background-color: @bg;
    padding: 16px;
}

mainbox {
    spacing: 12px;
    children: [
        inputbar,
        listview
    ];
}

inputbar {
    padding: 10px 12px;
    background-color: @surface;
    border: 1px;
    border-color: #252930;
    border-radius: 8px;

    children: [
        prompt,
        entry
    ];
}

prompt {
    padding: 0 10px 0 0;
    text-color: @accent;
}

entry {
    placeholder: "Choose wallpaper...";
    placeholder-color: @muted;
    text-color: @text;
}

listview {
    columns: 4;
    lines: 3;
    spacing: 8px;
    scrollbar: true;
    fixed-height: false;
}

element {
    orientation: vertical;
    padding: 6px;
    border-radius: 7px;
    background-color: @surface;
}

element selected {
    background-color: @surface-alt;
    border: 1px;
    border-color: @accent;
}

element-icon {
    size: 150px;
    horizontal-align: 0.5;
}

element-text {
    padding: 6px 2px 2px 2px;
    horizontal-align: 0.5;
    text-color: @muted;
}

element selected element-text {
    text-color: @accent;
}