@import "~/.cache/noir-signal/rofi-colors.rasi"

* {
    bg: @noir-bg;
    surface: @noir-surface;
    surface-alt: @noir-surface-alt;
    text: @noir-text;
    muted: @noir-muted;
    accent: @noir-accent;
    background-color: transparent;
    text-color: @text;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    width: 560px;
    height: 500px;
    border: 1px;
    border-color: @noir-outline;
    border-radius: 14px;
    border-left: 3px;
    border-left-color: @accent;
    background-color: @bg;
    padding: 20px;
}

mainbox {
    spacing: 16px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 12px 14px;
    background-color: @surface;
    border: 1px;
    border-color: @noir-outline;
    border-radius: 10px;
    children: [ prompt, entry ];
}

prompt {
    enabled: true;
    padding: 0 8px 0 0;
    text-color: @accent;
}

entry {
    placeholder: "Choose a control...";
    placeholder-color: @muted;
    text-color: @text;
}

listview {
    columns: 1;
    lines: 6;
    spacing: 5px;
    scrollbar: false;
}

element {
    padding: 11px 13px;
    border-radius: 9px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    text-color: @muted;
}

element selected {
    background-color: @surface-alt;
    border: 1px;
    border-color: @accent;
    border-left: 3px;
    border-left-color: @accent;
    padding: 11px 13px 11px 10px;
}

element selected element-text {
    text-color: @accent;
}
