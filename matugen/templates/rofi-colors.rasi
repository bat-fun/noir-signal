/* =========================================================
   NOIR SIGNAL — DYNAMIC ROFI COLORS
   Generated by Matugen
   ========================================================= */

* {
    noir-accent: {{colors.primary.dark.hex}};
    noir-secondary: {{colors.secondary.dark.hex}};
    noir-tertiary: {{colors.tertiary.dark.hex}};
    noir-muted: {{colors.on_surface_variant.dark.hex}};
    noir-outline: {{colors.outline.dark.hex}};
    noir-danger: {{colors.error.dark.hex}};

    noir-bg: #090A0C;
    noir-surface: #111318;
    noir-surface-alt: #181B21;
    noir-text: #E7E4DC;
}
